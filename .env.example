# ============================================================
# CrimeGraph AI — Environment Configuration Template
# Copy this file to .env.local for local development, or add
# these keys in Vercel / Render project environment settings.
# ============================================================

# --- Supabase Cloud Database ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Backend API Service (FastAPI / GNN Engine) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# For Production (e.g. deployed on Render):
# NEXT_PUBLIC_API_URL=https://crimegraph-ai-backend.onrender.com

# --- AI Investigation Copilot (Google Gemini) ---
# Get free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSy...

# --- Security & JWT Session ---
JWT_SECRET=replace-with-a-secure-random-32-character-secret
CRIMEGRAPH_API_KEY=replace-with-secure-api-key

# --- Network & Production Hosting ---
PORT=10000
NODE_ENV=production
ALLOWED_ORIGINS=https://crimegraph-ai.vercel.app,http://localhost:3000

# --- Blockchain Trust & Provenance Layer ---
# CrimeGraphAnchor contract on Polygon Amoy testnet (or Polygon PoS mainnet)
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_PRIVATE_KEY=0x_your_wallet_private_key_never_commit_this
BLOCKCHAIN_CONTRACT_ADDRESS=0x_deployed_contract_address
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com

# Frontend read-only (safe to expose — no signing capability)
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_BLOCKCHAIN_CONTRACT_ADDRESS=0x_deployed_contract_address
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=80002
